# Anthropic credential for the agent. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
BOATSCRUB_API_BASE_URL=https://boatscrubcalendar.com
# Optional: only if your API is protected
BOATSCRUB_API_KEY=

# Optional: allows fallback demo data if API calls fail
BOATSCRUB_ALLOW_DEMO_FALLBACK=false
